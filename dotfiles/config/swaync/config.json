{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "control-center-width": 400,
  "notification-window-width": 400,
  "notification-window-height": 120,
  "notification-2nd-action": true,
  "notification-inline-replies": false,
  "timeout": 10,
  "timeout-low": 6,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": false,
  "widgets": [
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    }
  }
}
