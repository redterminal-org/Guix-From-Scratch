{
    "migrated": true,
    "theme": "tokyo-night",
    "bindings": {
        "AddLocationToBookmarks": "ctrl+b",
        "SearchBookmarks": "B",
        "ToggleBookmarksManager": "f3",
        "SearchHistory": "H",
        "ToggleHistoryManager": "f2",
        "Forward": "K",
        "Backward": "J",
        "JumpToCommandLine": "C",
        "JumpToSidebar": "S",
        "Quit": "Q",
        "GoToRoot": "R",
        "GoHome": "W",
        "GoToParent": "P",
        "Reload": "f5"
    },
    "command_line_on_top": false,
    "displayable_content_types": [
        "text/gemini",
        "text/plain"
    ],
    "handle_ansi_escape_sequences": true,
    "strip_emoji": false,
    "side_panel_visible": false,
